# ---------------------------------------------------------------------------
# Rainbow Child Development Clinic — environment reference
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Existing backend (kept for the optional MySQL/Express path) ---
DATABASE_URL=
JWT_SECRET=

# --- Platform OAuth (existing clinician dashboard sign-in) ---
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- Supabase (new backend for patient identity + data) ---
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API. The anon/publishable key is safe for clients.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Express side). Keep out of client bundles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
